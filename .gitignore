.env
/docs

# Python
__pycache__/
*.pyc
*.pyo

# Logs
*.log
backend/logs/

# Local data exports (large, regenerable)
backend/*.csv
*.progress.json
backend/*.progress.json

# Scratch/one-off scripts convention — anything under backend/ that starts
# with an underscore is throwaway. Whitelist the few that graduated into
# real utilities.
backend/_*
!backend/_run_meta_parallel.py
!backend/_md_to_docx.py
!backend/_build_changelog_xlsx.py

# Editor / OS lock files
~$*
.claude/scheduled_tasks.lock

# Parallel-pipeline per-worker logs (regenerated each run)
backend/_parallel_logs/

# Structural helpers under _* (reproducible pipeline steps — whitelist)
!backend/_build_shopify_l30.py
!backend/_build_ae_daily_30d.py
!backend/_build_rck_last30.py
!backend/_build_rck_daily_30d.py
!backend/_build_ad_utm_mode.py
!backend/_build_utm_one_pager_docx.py
!backend/_fetch_new_orders_only.py
!backend/_run_meta_update_preserve_attr.py
!backend/_gads_web_auth.py
!backend/_export_rck_asset_and_name_overlap.py
!backend/_migrate_ireach_rpc_add_ad_level.sql
